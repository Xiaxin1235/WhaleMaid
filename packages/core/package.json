{
  "name": "@whaledot/core",
  "version": "0.0.0",
  "description": "Pure TypeScript domain layer for WhaleDot",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12"
  }
}
