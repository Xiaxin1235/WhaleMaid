{
  "name": "@whalemaid/core",
  "version": "1.2.2",
  "description": "Pure TypeScript domain models and policies for WhaleMaid project autopilot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xiaxin1235/WhaleMaid.git",
    "directory": "packages/core"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12"
  },
  "author": "Xiaxin1235",
  "homepage": "https://github.com/Xiaxin1235/WhaleMaid#readme",
  "bugs": {
    "url": "https://github.com/Xiaxin1235/WhaleMaid/issues"
  }
}
